# SendGrid transactional email. Leave SENDGRID_API_KEY empty to disable
# sending (methods no-op). Local dev (ENV=dev) logs the would-be email and
# does not send unless SENDGRID_FORCE_SEND=true.
# The dynamic template id must match the SendGrid editor; the Go method passes
# room_name (string), start_time (string) and end_time (string).
SENDGRID_API_KEY=
SENDGRID_TEMPLATE_BOOKING_CONFIRMATION=
SENDGRID_FORCE_SEND=false

# Google Calendar Configuration
GOOGLE_CREDENTIALS_BASE64=
GOOGLE_CALENDAR_ID=